{
    "name": "@exabyte-io/json-to-simpl-schema",
    "version": "0.0.0",
    "description": "JSON schema to simpl-schema conversion routines",
    "scripts": {
        "test": "nyc --reporter=text mocha --recursive --bail --require @babel/register/lib --require tests/setup.js tests",
        "lint": "eslint src tests && prettier --write src tests",
        "lint:fix": "eslint --fix --cache src tests && prettier --write src tests",
        "transpile": "babel --out-dir dist src",
        "postinstall": "npm run transpile"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/json-to-simpl-schema.git"
    },
    "main": "dist/main.js",
    "files": [
        "/dist",
        "/src",
        ".babelrc"
    ],
    "author": "Exabyte Inc.",
    "bugs": {
        "url": "https://github.com/mat3ra/json-to-simpl-schema/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/mat3ra/json-to-simpl-schema",
    "dependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/eslint-parser": "^7.29.7",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/register": "^7.29.7",
        "@babel/runtime-corejs3": "^7.29.7"
    },
    "devDependencies": {
        "chai": "^4.5.0",
        "eslint": "^7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^50.8.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "husky": "^7.0.4",
        "lint-staged": "^12.5.0",
        "mocha": "^9.2.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "simpl-schema": "git+https://github.com/mat3ra/simpl-schema.git#355fbea163da5be1946dc66c7ed951f53878d15c"
    },
    "peerDependencies": {
        "simpl-schema": "git+https://github.com/mat3ra/simpl-schema.git#355fbea163da5be1946dc66c7ed951f53878d15c"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,css}": "prettier --write"
    }
}
